{{#with (productreleases site.components page.component page.componentVersion page.url page.versions menu=true)}}
{{!-- A page in a product: the menu lists the product releases, also when there is only one. See helpers/productreleases.js. --}}
<div class="page-versions page-versions-releases">
  <button class="version-menu-toggle" title="Show other releases of page" data-release-current>{{#each this}}{{#if isCurrent}}{{label}}{{/if}}{{/each}}</button>
  <div class="version-menu">
    {{#each this}}
    <a class="version
      {{~#if isCurrent}} is-current{{/if~}}
      {{~#if missing}} is-missing{{/if}}" href="{{{relativize url}}}" data-release-option="{{version}}" data-release-label="{{label}}">{{label}}</a>
    {{/each}}
  </div>
</div>
{{else}}
{{#with page.versions}}
<div class="page-versions">
  <button class="version-menu-toggle" title="Show other versions of page">{{@root.page.componentVersion.displayVersion}}</button>
  <div class="version-menu">
    {{#each this}}
    <a class="version
      {{~#if (eq ./version @root.page.version)}} is-current{{/if~}}
      {{~#if ./missing}} is-missing{{/if}}" href="{{{relativize ./url}}}">{{./displayVersion}}</a>
    {{/each}}
  </div>
</div>
{{/with}}
{{/with}}
