<article class="doc">
{{! Custom changes start}}
{{> disclaimer}}
{{> prerelease}}
{{! Custom changes end}}
{{!-- A kw-landing page has its own heading and no pagination. --}}
{{#unless (eq page.attributes.role 'kw-landing')}}
{{#with page.title}}
<h1 class="page">{{{this}}}</h1>
{{/with}}
{{/unless}}
{{{page.contents}}}
{{#unless (eq page.attributes.role 'kw-landing')}}
{{> pagination}}
{{/unless}}
</article>
