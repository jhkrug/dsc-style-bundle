{{!-- Products and their releases come from the <product>-release-config.yml partials. See helpers/productreleases.js. --}}
<div class="nav-panel-explore{{#unless page.navigation}} is-active{{/unless}}" data-panel="explore">
  {{#if page.component}}
  {{#with (productreleases site.components page.component page.componentVersion page.url context=true)}}
  {{!-- A page in a product: the product above the component title, and the release as the version. --}}
  <div class="context" data-release-prefix="{{urlPrefix}}">
    <span class="title">{{#unless isLanding}}<span class="context-release">{{productTitle}}</span>{{/unless}}{{@root.page.component.title}}</span>
    <span class="version" data-release-current>{{label}}</span>
  </div>
  {{else}}
  <div class="context">
    <span class="title">{{page.component.title}}</span>
    <span class="version">{{#if (or page.componentVersion.version (ne page.componentVersion.displayVersion 'default'))}}{{page.componentVersion.displayVersion}}{{/if}}</span>
  </div>
  {{/with}}
  {{/if}}
  <ul class="components">
    {{#each (productreleases site.components page.component page.componentVersion page.url)}}
    {{#if product}}
    <li class="component component-product{{#if isCurrent}} is-current{{/if}}" data-product="{{urlPrefix}}">
      <div class="title"><a href="{{{relativize url}}}">{{{title}}}</a></div>
      <ul class="versions">
        {{#each releases}}
        <li class="version{{#if isCurrent}} is-current{{/if}}" data-release-option="{{version}}" data-release-label="{{label}}">
          <a href="{{{relativize url}}}">{{label}}</a>
        </li>
        {{/each}}
      </ul>
    </li>
    {{else}}
    <li class="component{{#if isCurrent}} is-current{{/if}}">
      <div class="title"><a href="{{{relativize component.url}}}">{{{component.title}}}</a></div>
      {{#if (or component.versions.[1] component.versions.[0].version (ne component.versions.[0].displayVersion 'default'))}}
      <ul class="versions">
        {{#each component.versions}}
        <li class="version
          {{~#if (and (eq ../component @root.page.component) (eq this @root.page.componentVersion))}} is-current{{/if~}}
          {{~#if (eq this ../component.latest)}} is-latest{{/if}}">
          <a href="{{{relativize ./url}}}">{{./displayVersion}}</a>
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </li>
    {{/if}}
    {{/each}}
  </ul>
</div>
