{{#with page.navigation}}
{{!-- The landing page of a product opens all the sections of its navigation. See js/nav-menu-toggle.js. --}}
<div class="nav-panel-menu is-active" data-panel="menu"
  {{~#with (productreleases @root.site.components @root.page.component @root.page.componentVersion @root.page.url context=true)}}{{#if isLanding}} data-start-expanded{{/if}}{{/with}}>
  <nav class="nav-menu">
    {{!-- js/nav-menu-toggle.js shows this button. The bundle site.js does not handle it. --}}
    <button type="button" class="nav-menu-toggle" aria-label="Expand all navigation sections" title="Expand all navigation sections" style="display: none">
      {{!-- Lucide unfold-vertical and fold-vertical; ISC license in img/LUCIDE-LICENSE.txt. --}}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22v-6M12 8V2M4 12H2M10 12H8M16 12h-2M22 12h-2"/>
        <path class="nav-unfold-icon" d="m15 19-3 3-3-3m6-14-3-3-3 3"/>
        <path class="nav-fold-icon" d="m15 19-3-3-3 3m6-14-3 3-3-3"/>
      </svg>
    </button>
    {{#with @root.page.componentVersion}}
    {{!-- <h3 class="title"><a href="{{{relativize ./url}}}">{{./title}}</a></h3> --}}
    {{!-- Next line replaces the one commented above. It's to make the pseudo breadcrumbs appear more sensible. May change again. --}}
    <h3 class="title">{{./title}}</h3>
    {{/with}}
{{> nav-tree navigation=(navfilter this @root.page.module)}}
  </nav>
</div>
{{/with}}
